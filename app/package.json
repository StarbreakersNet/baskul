{
  "name": "baskul",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "lint:oxlint": "oxlint src --fix -D correctness --import-plugin -D import/first",
    "lint:eslint": "eslint . --fix --cache",
    "lint:names": "node scripts/check-names.mjs",
    "lint": "run-s \"lint:*\"",
    "format": "prettier --write src/",
    "tauri": "tauri",
    "test": "vitest run"
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.49.0",
    "@tauri-apps/api": "^2.12.4",
    "naive-ui": "^2.45.3",
    "pinia": "^3.0.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^22.18.11",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "eslint": "^9.37.0",
    "eslint-plugin-oxlint": "~1.23.0",
    "eslint-plugin-vue": "~10.5.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.23.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.4",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.3.13"
  }
}
